# Copy this file to .env and fill in the values. Never commit the real .env.
# Each credential is only needed once we reach the step that integrates that platform,
# so leave the ones we have not reached yet blank.

# Database. The default below matches the local Postgres in docker-compose.yml,
# which is published on host port 5433 to avoid clashing with any PostgreSQL that
# is already installed locally on the standard 5432.
DATABASE_URL=postgresql://yukiverse:yukiverse@localhost:5433/yukiverse

# --- Codeforces (Step 1) ---
CF_HANDLE=

# --- GitHub (Step 2) ---
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- AtCoder (Step 3) ---
AC_HANDLE=

# --- LeetCode (Steps 4 and 5) ---
LC_USERNAME=
LC_SESSION_COOKIE=

# Sync scheduler (Step 6). Stats platforms use this interval; GitHub is fixed at 1 hour.
SYNC_INTERVAL_HOURS=6
